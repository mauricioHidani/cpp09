NAME		= PmergeMe
SINCE		= 2026.04.12
AUTHOR		= mhidani
LOCAL		= 42SP
VERSION		= 1.0.0v

TIMESTAMP	= $(shell date +%Y%m%d_%H%M%S)

INC_DIR		= includes
TPL_DIR		= templates
SRC_DIR		= src
OBJ_DIR		= obj

SRC_FLS		= PmergeMe.cpp
MAIN		= main.cpp

SRCS		= $(addprefix $(SRC_DIR)/, $(SRC_FLS))

SRC_OBJS	= $(addprefix $(OBJ_DIR)/, $(SRC_FLS:.cpp=.o))
MAIN_OBJ	= $(OBJ_DIR)/$(MAIN:.cpp=.o)
OBJS		= $(SRC_OBJS) $(MAIN_OBJ)

CXX			= c++
CXXFLAGS	= -Wall -Wextra -Werror -std=c++98 -g
CXXINCS		= -I$(INC_DIR) -I$(TPL_DIR)

VALGRIND	= valgrind
VGDLOG		= valgrind_$(TIMESTAMP).log
VGDFLAGS	= --leak-check=full --track-origins=yes --show-leak-kinds=all
VGDFLGLG	= --log-file=

MKD			= mkdir
MKDFLAGS	= --parents
RM			= rm
RMFLAGS		= --force --recursive
ARGS		= 

define check_created
	if [ -f $(1) ]; then \
		echo "🟢 $(1): is created"; \
	else \
		echo "🔴 $(1): doesn't created"; \
	fi
endef

define remove_dir_exists
	if [ -d $(1) ]; then \
		$(RM) $(RMFLAGS) $(1); \
		echo "🟢 $(1): is cleaned"; \
	else \
		echo "🟠 $(1): doesn't exists and not cleaned"; \
	fi
endef

define remove_file_exists
	if [ -f $(1) ]; then \
		$(RM) $(RMFLAGS) $(1); \
		echo "🟢 $(1): is cleaned"; \
	else \
		echo "🟠 $(1): doesn't exists and not cleaned"; \
	fi
endef

define run_test
	$(eval CURRENT_LOG := valgrind_test$(strip $(1))_$(shell date +%Y%m%d_%H%M%S).log)
	@echo "🚩 Test $(1)"
	@echo "🔻 input> $(2)"
	@echo "🔺 output> "
	@$(VALGRIND) $(VGDFLAGS) $(VGDFLGLG)$(CURRENT_LOG) ./$(NAME) "$(2)" || true
	@echo "🔹 expected> $(3)"
	@$(call check_created,$(CURRENT_LOG))
	@echo ""
endef

define run_large_test
	$(eval INPUT := $(shell shuf -i 1-3000 -n $(2) | paste -sd ' ' -))
	@echo "🚩 Large test ($(2) numbers)"
	@./$(NAME) "$(INPUT)" | tee "output_test$(1)_$(2).txt"
	@echo "$(INPUT)" | tr ' ' '\n' | sort -n > "expected_test$(1)_$(2).txt"
	@grep "After:" "output_test$(1)_$(2).txt" | cut -d':' -f2 | tr ' ' '\n' | sed '/^$$/d' > "after_test$(1)_$(2).txt"
	@diff "expected_test$(1)_$(2).txt" "after_test$(1)_$(2).txt" && echo "✅ OK" || echo "❌ KO"
	@echo
endef

all: banner $(NAME)

clean:
	@$(call remove_dir_exists, $(OBJ_DIR))

clean_logs:
	@$(RM) $(RMFLAGS) valgrind_*.log
	@echo "🟧 valgrind logs is cleaned"

fclean: clean
	@$(call remove_file_exists, $(NAME))

re: fclean all

banner:
	@echo "🛸 $(LOCAL) - [CPP-09 Exercise 02]"
	@echo "PmergeMe"
	@echo "$(NAME) $(VERSION)"
	@echo "$(AUTHOR) $(SINCE)"
	@echo 

run: banner $(NAME)
	@$(VALGRIND) $(VGDFLAGS) ./$(NAME) $(ARGS)
	@$(call check_created, $(VGDLOG))

test: banner $(NAME)
	@echo "🥋 Running the tests"
